{
  "name": "inspire-media-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/program-csv.test.ts tests/payments.test.ts tests/music.test.ts",
    "test:security": "node --test tests/security.test.ts",
    "db:start": "supabase start -x realtime,imgproxy,edge-runtime,logflare,vector,supavisor",
    "db:reset": "supabase db reset",
    "db:stop": "supabase stop",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "db:live-grants": "node scripts/live-grants.mjs | docker exec -i supabase_db_inspire-media psql -U postgres -q"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "next": "16.4.6",
    "papaparse": "^5.7.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "supabase": "^3.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
