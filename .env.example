# Copy this file to .env.local (Windows: copy .env.example .env.local).
# These are the standard values for the local test database started by `npm run db:start`.
# For the live website, use the values from your Supabase project's settings instead.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# --- Payments (optional locally; set these in Vercel for the live site) ---
# Server key from Supabase (Project Settings > API Keys > Secret key). Never share it.
# Locally it's the "SECRET_KEY" shown by `npx supabase status`.
SUPABASE_SECRET_KEY=
# Square: Sandbox access token from developer.squareup.com > your app > Credentials.
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
# PayPal: Sandbox Client ID and Secret from developer.paypal.com > Apps & Credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
# Backup payment notifications ("webhooks"), see README/DECISIONS.
# Square: Developer Console > your app > Webhooks > Subscriptions > the subscription's Signature key.
SQUARE_WEBHOOK_SIGNATURE_KEY=
# PayPal: developer.paypal.com > Apps & Credentials > your app > Webhooks > Webhook ID.
PAYPAL_WEBHOOK_ID=
# Optional: shown on receipts.
RECEIPT_BUSINESS_NAME=Inspire Dance & Fitness
RECEIPT_ABN=

# Optional: email shown on the Privacy and terms page for privacy questions.
CONTACT_EMAIL=
